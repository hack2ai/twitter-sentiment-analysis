FRONTEND_ORIGIN=http://localhost:3000
MAX_BATCH_ROWS=1000
MAX_BATCH_FILE_BYTES=10485760
SECRET_KEY=replace-with-a-long-random-secret-before-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
AUTH_RATE_LIMIT=5
AUTH_RATE_WINDOW_SECONDS=60
# Local SQLite fallback is used when DATABASE_URL is omitted.
# PostgreSQL example:
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/sentiment_db
